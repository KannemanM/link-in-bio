# Copia este archivo a .github/workflows/ci.yml para activar CI en GitHub Actions.
name: CI

on:
  push:
    branches:
      - main
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Instalar dependencias
        run: npm ci --no-audit --no-fund

      - name: Comprobar sintaxis
        run: npm run check

      - name: Ejecutar pruebas
        run: npm test

      - name: Validar links.json
        run: npm run validate
