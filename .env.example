# Copia este archivo como .env y ajusta los valores.
# Docker Compose lee este archivo automáticamente.

# --- Dominio y URL pública ---
# DOMAIN lo usa Caddy para pedir el certificado TLS.
# SITE_URL debe ser la URL pública completa, sin barra final.
DOMAIN=links.example.com
SITE_URL=https://links.example.com

# --- Despliegue en LAN con compose.lan.yaml ---
# Para HTTP simple dentro de la LAN, usa por ejemplo:
#   SITE_URL=http://192.168.1.50
#   BIND_IP=192.168.1.50
# DOMAIN no se usa con compose.lan.yaml. BIND_IP limita el puerto 80 a esa IP.
# BIND_IP=192.168.1.50

# --- Acceso privado ---
# Una sola cuenta para /admin y /stats. Genera una contraseña larga:
#   openssl rand -base64 32
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave-de-admin

# Secreto opcional para firmar la cookie de sesión. Si no se define, se genera
# automáticamente en /data/.session-secret (o data/.session-secret en local).
# SESSION_SECRET=

# --- Presentación ---
STATS_TZ=America/Argentina/Buenos_Aires

# --- Opcional: desarrollo local sin Docker ---
# Compose define estas rutas dentro de /data. Si ejecutas `npm start` en tu equipo,
# los valores por defecto ya apuntan a ./links.json y ./data/.
# PORT=3000
# HOST=127.0.0.1
# TRUST_PROXY=0
# LINKS_FILE=./links.json
# CLICKS_LOG=./data/clicks.log
# AVATAR_FILE=./data/avatar.png
# OG_FILE=./data/og.png
# FAVICON_FILE=./data/favicon.svg
# BACKUP_DIR=./data/backups
